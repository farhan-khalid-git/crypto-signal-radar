<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/overlay_root"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <LinearLayout
    android:id="@+id/overlay_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_background"
    android:padding="14dp"
    android:orientation="vertical">

    <View
      android:id="@+id/overlay_handle"
      android:layout_width="36dp"
      android:layout_height="4dp"
      android:layout_gravity="center_horizontal"
      android:layout_marginBottom="8dp"
      android:background="@drawable/overlay_handle" />

    <TextView
      android:id="@+id/overlay_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/app_name"
      android:textColor="#F4F2EB"
      android:textStyle="bold"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/overlay_message"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:text="Waiting for alerts..."
      android:textColor="#C2C7CF"
      android:textSize="12sp" />

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/overlay_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_chip"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="OPEN"
        android:textColor="#F4F2EB"
        android:textSize="12sp" />

      <TextView
        android:id="@+id/overlay_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/overlay_chip"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="X"
        android:textColor="#FF6B6B"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <FrameLayout
    android:id="@+id/overlay_collapsed"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <TextView
      android:id="@+id/overlay_collapsed_icon"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:background="@drawable/overlay_bubble"
      android:gravity="center"
      android:text="CSR"
      android:textColor="#F4F2EB"
      android:textSize="12sp"
      android:textStyle="bold" />
  </FrameLayout>
</LinearLayout>
